{
    "target": "esp32s3",
    "builds": [
        {
            "name": "atoms3r-echo-base",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m_plusone.csv\"",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"ni hao niu niu\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"你好牛牛\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "CONFIG_WIFI_CONFIG_SSID_PREFIX=\"NiuNiu\""
            ]
        }
    ]
}
